{
  "repo": "AURORA-NEURO/aurora-cranio",
  "branch": "codex/coverage-100",
  "baseBranch": "main",
  "coveragePolicy": {
    "line": 100,
    "branch": 100,
    "function": 100,
    "statement": 100,
    "generatedAndNonExecutableExclusions": [
      "dist",
      "build",
      "coverage",
      "docs",
      "notebooks",
      "fixtures",
      "generated clients",
      "vendored assets",
      "binary model weights",
      "test files"
    ]
  },
  "requiredScenarioCases": 1200,
  "stack": {
    "node": false,
    "python": false,
    "pnpm": false,
    "vitest": false,
    "jest": false,
    "nodeTest": false
  },
